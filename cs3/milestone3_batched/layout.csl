// Batched variant of milestone2's kernel: instead of one column processing
// one pair at a time (0.11% of the fabric used, ~99% of wall time spent on
// the per-pair network round-trip), tile up to `width` independent copies
// of the same 1-column-per-pair design side by side, each column an
// entirely separate pairwise alignment. One memcpy_h2d/launch/memcpy_d2h
// round-trip now processes up to `width` pairs simultaneously instead of
// one -- the round-trip cost is what dominated, so amortizing it across a
// wide batch is the fix, not making any single alignment faster.
//
// Per-column logic (the N/S wavefront recurrence, the 2-color checkerboard
// link scheme) is unchanged from milestone2 -- columns don't interact, so
// the same 2 colors are safely reused in every column (routing is
// per-(x,y) tile, not global).

param m: i16;     // PEs per column = len(A) for one pairwise alignment
param n: i16;     // len(B)
param width: i16; // number of pairs processed per launch (<=762 on real hardware)

const memcpy = @import_module("<memcpy/get_params>", .{ .width = width, .height = m });

const color_even = @get_color(0);
const color_odd = @get_color(1);

layout {
  @set_rectangle(width, m);

  for (@range(i16, width)) |x| {
    for (@range(i16, m)) |y| {
      @set_tile_code(x, y, "pe_program.csl", .{
        .memcpy_params = memcpy.get_params(x),
        .n = n,
        .row_index = y + 1,
        .has_north = y > 0,
        .has_south = y < m - 1,
        .north_color = if ((y - 1) % 2 == 0) color_even else color_odd,
        .south_color = if (y % 2 == 0) color_even else color_odd,
      });
    }
  }

  for (@range(i16, width)) |x| {
    for (@range(i16, m - 1)) |k| {
      const c = if (k % 2 == 0) color_even else color_odd;
      @set_color_config(x, k, c, .{ .routes = .{ .rx = .{ RAMP }, .tx = .{ SOUTH } } });
      @set_color_config(x, k + 1, c, .{ .routes = .{ .rx = .{ NORTH }, .tx = .{ RAMP } } });
    }
  }

  @export_name("a_char", [*]i32, true);
  @export_name("B", [*]i32, true);
  @export_name("H_row", [*]i32, false);
  @export_name("TB_row", [*]u32, false);
  @export_name("compute", fn()void);
}
